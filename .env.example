# ==================================
# 왈가왈부 (WalGaWalBu) - Environment Variables
# ==================================
# 운영자가 .env.local 또는 배포 환경변수에서 설정합니다.
# AI 비밀 키와 Supabase secret key는 서버에서만 사용합니다. NEXT_PUBLIC_ 접두사 금지.

# ─── 서비스가 제공하는 AI 연결 (토너먼트 + 기존 캐릭터 토론) ───
OPENROUTER_API_KEY=
# 제공할 모델 ID를 쉼표로 구분합니다. 실제 AI 실행에는 비어 있지 않은 목록이 필수입니다.
# 아래는 대표 선수 15명의 설정 예시입니다. 키와 실행 플래그 설정 전에는 유료 호출하지 않습니다.
# 비우면 대표 선수 중 공개 카탈로그에 있는 모델을 탐색할 수 있지만 AI 실행은 차단됩니다.
OPENROUTER_ALLOWED_MODELS=google/gemini-3.8-flash,anthropic/claude-haiku-4.5,openai/gpt-5.6-luna,x-ai/grok-4.6,deepseek/deepseek-v4-pro-0813,qwen/qwen3.8-flash,moonshotai/kimi-k2.6,upstage/solar-pro4,arcee-ai/trinity-large-thinking,nvidia/nemotron-3-ultra-550b-a55b,tencent/hy4-preview,z-ai/glm-5.3-flash,minimax/minimax-m3,meta/muse-spark-1.3,sakana/sakana-namazu
# 선택: 기존 OpenAI Moderation API용 서버 키
OPENAI_API_KEY=

# ─── 선택 사항: Bareun.ai ───
# 한글 형태소 분석용 서버 키. 별도 서비스의 이용 조건과 요금을 확인합니다.
BAREUN_API_KEY=

# ─── 기타 설정 ───
# 로그인과 실행 원장 — 테스트/운영 프로젝트를 분리합니다.
# 아래 URL과 publishable key는 공개 가능한 프로젝트 식별 정보입니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 Supabase secret key (또는 service_role key). 브라우저에 전달하지 않습니다.
SUPABASE_SECRET_KEY=
# Supabase 마이그레이션·Google OAuth·모델 허용 목록·OpenRouter 예산 설정 후 활성화합니다.
AI_EXECUTION_ENABLED=false
# 한국 시간 자정 기준, 시작한 경기/기존 보조 API 요청의 일일 상한
AI_DAILY_MATCH_LIMIT=3
AI_DAILY_ASSIST_LIMIT=30
