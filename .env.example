# ==================================
# 왈가왈부 (WalGaWalBu) - Environment Variables
# ==================================
# 운영자가 .env.local 또는 배포 환경변수에서 설정합니다.
# 브라우저에는 키를 저장하거나 전송하지 않습니다. NEXT_PUBLIC_ 접두사 금지.

# ─── 서비스가 제공하는 AI 연결 (토너먼트 + 기존 캐릭터 토론) ───
OPENROUTER_API_KEY=
# 선택: 제공할 모델 ID를 쉼표로 구분합니다. 비워두면 공개 텍스트 모델을 제공합니다.
# 카탈로그와 경기 API에 동일하게 적용합니다.
OPENROUTER_ALLOWED_MODELS=
# 선택: 기존 OpenAI Moderation API용 서버 키
OPENAI_API_KEY=

# ─── Bareun.ai (무료 API — 서버 기본 제공) ───
# 한글 형태소 분석용. 무료이므로 Vercel 환경변수에 등록하여 기본 제공합니다.
# https://bareun.ai 에서 무료 키를 발급받을 수 있습니다.
BAREUN_API_KEY=

# ─── 기타 설정 ───
# 일일 사용 제한 (기본: 50)
NEXT_PUBLIC_DAILY_LIMIT=50
